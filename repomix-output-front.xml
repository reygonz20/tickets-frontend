  height: 92px;
  background: linear-gradient(135deg, #3b82f6 0%, #4f46e5 50%, #06b6d4 100%);
}

.profile-avatar-wrapper {
  margin-top: -36px;
  display: flex;
  justify-content: center;
}

.profile-avatar {
  width: 72px;
  height: 72px;
  border-radius: 20px;
  background: linear-gradient(135deg, #e0e7ff 0%, #dbeafe 100%);
  color: #2563eb;
  font-size: 1.45rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4px solid #ffffff;
  box-shadow: 0 8px 16px rgba(15, 23, 42, 0.08);
}

.profile-identity {
  padding: 0.85rem 1.25rem 1.5rem;
}

.profile-name {
  font-size: 1.15rem;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 0.25rem;
}

.profile-dept {
  font-size: 0.8rem;
  color: #64748b;
  margin-bottom: 0.85rem;
}

.profile-stats {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-around;
  border-top: 1px solid #f1f5f9;
  padding: 1.1rem 1rem;
}

.stat-box {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.stat-number {
  font-size: 1.2rem;
  font-weight: 700;
  color: #0f172a;
}

.stat-label {
  font-size: 0.72rem;
  color: #94a3b8;
}

.stat-divider {
  width: 1px;
  height: 32px;
  background-color: #f1f5f9;
}

/* --- TARJETA DERECHA (DETALLES Y SEGURIDAD) --- */
.profile-details-card {
  background: #ffffff;
  border-radius: 20px;
  border: 1px solid #e2e8f0;
  padding: 1.85rem 2rem;
  box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04);
}

.details-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.75rem;
}

.details-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 0.2rem;
}

.details-subtitle {
  font-size: 0.82rem;
  color: #64748b;
}

.btn-outline {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  padding: 0.55rem 1rem;
  font-size: 0.82rem;
  font-weight: 600;
  color: #1e293b;
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  cursor: pointer;
  transition: all 0.15s ease;
}

.btn-outline:hover {
  background: #f8fafc;
  border-color: #cbd5e1;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  row-gap: 1.5rem;
  column-gap: 2rem;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}

.info-label {
  font-size: 0.75rem;
  color: #94a3b8;
}

.info-value {
  font-size: 0.9rem;
  font-weight: 600;
  color: #0f172a;
}

.section-divider {
  border: none;
  border-top: 1px solid #f1f5f9;
  margin: 1.85rem 0 1.5rem;
}

.security-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.security-left {
  display: flex;
  align-items: center;
  gap: 0.9rem;
}

.security-icon-box {
  width: 40px;
  height: 40px;
  border-radius: 12px;
  background-color: #eff6ff;
  color: #3b82f6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.security-title {
  font-size: 0.9rem;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 0.15rem;
}

.security-subtitle {
  font-size: 0.78rem;
  color: #94a3b8;
}

/* --- INPUTS ESPECIALES DE LOS MODALES DE PERFIL --- */
.input-disabled {
  background-color: #f1f5f9 !important;
  color: #64748b !important;
  cursor: not-allowed;
}

.password-input-box {
  position: relative;
  display: flex;
  align-items: center;
}

.password-input-box input {
  padding-right: 4.5rem;
}

.btn-eye {
