<file path="src/app/pages/catalogos/catalogos.css">
:host {
  display: block;
}

.catalog-page {
  min-width: 0;
}

.catalog-card {
  overflow: hidden;
}

.catalog-summary {
  min-height: 82px;
  padding: 1.15rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  border-bottom: 1px solid #f1f5f9;
  background: #ffffff;
}

.catalog-summary > div {
  display: flex;
  flex-direction: column;
  gap: 0.18rem;
}

.catalog-summary-label,
.catalog-summary-note {
  color: #94a3b8;
  font-size: 0.76rem;
  font-weight: 600;
}

.catalog-summary strong {
  color: #0f172a;
  font-size: 1.45rem;
}

.catalog-table-scroll {
  max-height: calc(100vh - 300px);
}

.catalog-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
}

.catalog-table thead th {
  position: sticky;
  top: 0;
  z-index: 5;
  padding: 0.9rem 1.5rem;
  background: #fafcfe;
  border-bottom: 1px solid #f1f5f9;
  color: #94a3b8;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.06em;
}

.catalog-table tbody tr {
  border-bottom: 1px solid #f1f5f9;
  transition: background-color 0.15s ease;
}

.catalog-table tbody tr:hover {
  background: #f8fafc;
}

.catalog-table tbody td {
  padding: 1rem 1.5rem;
  font-size: 0.86rem;
  vertical-align: middle;
}

.catalog-name-cell,
.priority-cell {
  display: flex;
  align-items: center;
  gap: 0.8rem;
}

.catalog-name-cell > div {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.catalog-name-cell strong,
.priority-cell strong {
  color: #0f172a;
  font-weight: 600;
}

.catalog-name-cell small {
  color: #94a3b8;
  font-size: 0.72rem;
}

.catalog-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #eff6ff;
  color: #2563eb;
}

.catalog-kpis {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  max-width: 760px;
}

.catalog-columns {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(340px, 0.85fr);
  gap: 1.25rem;
}

.catalog-section-heading {
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid #f1f5f9;
}

.catalog-section-heading h2 {
  margin: 0 0 0.2rem;
  color: #0f172a;
  font-size: 1rem;
}

.catalog-section-heading p {
  margin: 0;
  color: #94a3b8;
  font-size: 0.78rem;
}

.priority-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #94a3b8;
  box-shadow: 0 0 0 4px #f1f5f9;
}

.priority-critica,
.priority-crítica {
  background: #ef4444;
  box-shadow: 0 0 0 4px #fee2e2;
}

.priority-alta {
  background: #f97316;
  box-shadow: 0 0 0 4px #ffedd5;
}

.priority-media {
  background: #f59e0b;
  box-shadow: 0 0 0 4px #fef3c7;
}

.priority-baja {
  background: #6366f1;
  box-shadow: 0 0 0 4px #e0e7ff;
}

.states-list {
  padding: 0.4rem 1.5rem 1rem;
}

.state-item {
  display: flex;
  align-items: center;
  gap: 0.9rem;
  padding: 0.95rem 0;
  border-bottom: 1px solid #f1f5f9;
}

.state-item:last-child {
  border-bottom: none;
}

.state-order {
  flex: 0 0 34px;
  width: 34px;
  height: 34px;
  border-radius: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #eff6ff;
  color: #2563eb;
  font-size: 0.78rem;
  font-weight: 700;
}

.state-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 0.18rem;
}

.state-copy strong {
  color: #0f172a;
  font-size: 0.84rem;
}

.state-copy small {
  color: #94a3b8;
  font-size: 0.75rem;
  line-height: 1.35;
}

@media (max-width: 980px) {
  .catalog-columns {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .catalog-summary {
    align-items: flex-start;
    flex-direction: column;
  }

  .catalog-kpis {
    grid-template-columns: 1fr;
  }
}

.catalog-actions {
  display: flex;
  justify-content: flex-end;
  gap: .45rem;
}

.catalog-protected {
  display: block;
  margin-top: .2rem;
  color: #94a3b8;
  font-size: .7rem;
  font-weight: 600;
}
</file>

<file path="src/app/pages/catalogos/catalogos.html">
<div class="catalog-page">
  <div class="page-header">
    <div>
      <p class="page-kicker">CONFIGURACIÓN DE TICKETS</p>
      <h1 class="page-title">{{ titulo }}</h1>
      <p class="page-subtitle">{{ subtitulo }}</p>
    </div>
    <button type="button" class="btn-primary" (click)="abrirNuevo()"><span>＋</span><span>{{ etiquetaBoton }}</span>
    </button>
  </div>

  @if (mensaje) {
    <div class="page-alert page-alert-success">{{ mensaje }}</div>
  }
  @if (error && !mostrarModal) {
    <div class="page-alert page-alert-error">{{ error }}</div>
  }

  @if (vista === 'categorias') {
    <div class="summary-grid catalog-kpis">
      <div class="summary-card"><span class="summary-label">Categorías registradas</span><strong
        class="summary-value">{{ categorias.length }}</strong></div>
      <div class="summary-card"><span class="summary-label">Categorías activas</span><strong
        class="summary-value">{{ totalCategoriasActivas }}</strong></div>
    </div>
    <div class="table-card catalog-card">
      <div class="table-responsive catalog-table-scroll">
        <table class="catalog-table">
          <thead>
          <tr>
            <th>CATEGORÍA</th>
            <th>DESCRIPCIÓN</th>
            <th>ESTADO</th>
            <th class="text-right"></th>
          </tr>
          </thead>
          <tbody>
            @for (c of categorias; track c.idCategoria) {
              <tr>
                <td>
                  <div class="catalog-name-cell"><span class="catalog-icon">◎</span>
                    <div><strong>{{ c.nombre }}</strong></div>
                  </div>
                </td>
                <td class="text-muted">{{ c.descripcion || 'Sin descripción registrada' }}</td>
                <td><span class="status-badge"
                          [ngClass]="c.estado === false ? 'status-inactive' : 'status-active'"><span
                  class="dot"></span>{{ c.estado === false ? 'Inactiva' : 'Activa' }}</span></td>
                <td class="text-right">
                  <div class="catalog-actions">
                    <button class="btn-edit-square" type="button" (click)="editarCategoria(c)" title="Editar">✎
                    </button>@if (c.estado !== false) {
                    <button class="btn-delete-square" type="button" (click)="desactivarCategoria(c)" title="Desactivar">
                      ×
                    </button>
                  }</div>
                </td>
              </tr>
            } @empty {
              <tr>
                <td colspan="4" class="empty-row">No hay categorías registradas.</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  }

  @if (vista === 'prioridades') {
    <div class="summary-grid catalog-kpis">
      <div class="summary-card"><span class="summary-label">Prioridades registradas</span><strong
        class="summary-value">{{ prioridades.length }}</strong></div>
    </div>
    <div class="table-card catalog-card">
      <div class="table-responsive catalog-table-scroll">
        <table class="catalog-table">
          <thead>
          <tr>
            <th>PRIORIDAD</th>
            <th class="text-right"></th>
          </tr>
          </thead>
          <tbody>
            @for (p of prioridades; track p.idPrioridad) {
              <tr>
                <td>
                  <div class="priority-cell"><span class="priority-dot"
                                                   [ngClass]="'priority-' + (p.nombre || '').toLowerCase()"></span><strong>{{ formatear(p.nombre) }}</strong>
                  </div>
                </td>
                <td class="text-right">
                  <div class="catalog-actions">
                    <button class="btn-edit-square" type="button" (click)="editarPrioridad(p)" title="Editar">✎</button>
                    <button class="btn-delete-square" type="button" (click)="eliminarPrioridad(p)" title="Eliminar">×
                    </button>
                  </div>
                </td>
              </tr>
            } @empty {
              <tr>
                <td colspan="2" class="empty-row">No hay prioridades registradas.</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  }

  @if (vista === 'estados') {
    <div class="summary-grid catalog-kpis">
      <div class="summary-card"><span class="summary-label">Estados registrados</span><strong
        class="summary-value">{{ estados.length }}</strong></div>
      <div class="summary-card"><span class="summary-label">Estados base protegidos</span><strong class="summary-value">7</strong>
      </div>
    </div>
    <div class="table-card catalog-card">
      <div class="table-responsive catalog-table-scroll">
        <table class="catalog-table">
          <thead>
          <tr>
            <th>ORDEN</th>
            <th>ESTADO</th>
            <th>DESCRIPCIÓN</th>
            <th class="text-right"></th>
          </tr>
          </thead>
          <tbody>
            @for (e of estados; track e.idEstado) {
              <tr>
                <td><span class="state-order">{{ e.orden }}</span></td>
                <td><strong>{{ formatear(e.nombre) }}</strong>@if (esEstadoBase(e)) {
                  <small class="catalog-protected">Estado base</small>
                }</td>
                <td class="text-muted">{{ e.descripcion || 'Sin descripción registrada' }}</td>
                <td class="text-right">
                  <div class="catalog-actions">
                    <button class="btn-edit-square" type="button" (click)="editarEstado(e)" title="Editar">✎</button>
                    <button class="btn-delete-square" type="button" (click)="eliminarEstado(e)"
                            [disabled]="esEstadoBase(e)" title="Eliminar">×
                    </button>
                  </div>
                </td>
              </tr>
            } @empty {
              <tr>
                <td colspan="4" class="empty-row">No hay estados registrados.</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  }

  @if (mostrarModal) {
    <div class="modal-backdrop" (click)="cerrarModal()">
      <div class="modal-card modal-card-sm" (click)="$event.stopPropagation()">
        <div class="modal-header">
          <div><p class="modal-kicker">CONFIGURACIÓN</p>
            <h2
              class="modal-title">{{ editando ? 'Editar' : 'Crear' }} {{ titulo.toLowerCase().replace('categorías', 'categoría').replace('prioridades', 'prioridad').replace('estados', 'estado') }}</h2>
            <p class="modal-subtitle">Los cambios se aplicarán al catálogo utilizado por los tickets.</p></div>
          <button type="button" class="btn-close" (click)="cerrarModal()">✕</button>
        </div>
        @if (error) {
          <div class="modal-alert-error">{{ error }}</div>
        }
        <form class="modal-form" (ngSubmit)="guardar()" novalidate>
          @if (vista === 'categorias') {
            <div class="form-field" [class.form-field-invalid]="errores['nombre']"><label>Nombre</label><input
              [(ngModel)]="formCategoria.nombre" name="nombreCategoria" maxlength="100"
              placeholder="Ej. Redes" />@if (errores['nombre']) {
              <small class="form-field-error">{{ errores['nombre'] }}</small>
            }</div>
            <div class="form-field" [class.form-field-invalid]="errores['descripcion']">
              <label>Descripción</label><textarea [(ngModel)]="formCategoria.descripcion" name="descripcionCategoria"
                                                  rows="4" maxlength="255"
                                                  placeholder="Describe el tipo de incidencias"></textarea>@if (errores['descripcion']) {
              <small class="form-field-error">{{ errores['descripcion'] }}</small>
            }</div>
            @if (editando) {
              <div class="form-field"><label>Estado</label><select [(ngModel)]="formCategoria.estado"
                                                                   name="estadoCategoria">
                <option [ngValue]="true">Activa</option>
                <option [ngValue]="false">Inactiva</option>
              </select></div>
            }
          }
          @if (vista === 'prioridades') {
            <div class="form-field" [class.form-field-invalid]="errores['nombre']"><label>Nombre</label><input
              [(ngModel)]="formPrioridad.nombre" name="nombrePrioridad" maxlength="50"
              placeholder="Ej. URGENTE" />@if (errores['nombre']) {
              <small class="form-field-error">{{ errores['nombre'] }}</small>
            }</div>
          }
          @if (vista === 'estados') {
            <div class="form-field" [class.form-field-invalid]="errores['nombre']"><label>Nombre funcional</label><input
              [(ngModel)]="formEstado.nombre" name="nombreEstado" maxlength="50"
              [disabled]="editando && estadosBase.has(formEstado.nombre.toUpperCase())"
              placeholder="Ej. EN_REVISION" />@if (editando && estadosBase.has(formEstado.nombre.toUpperCase())) {
              <small class="form-help">El nombre de un estado base no puede modificarse.</small>
            }
              @if (errores['nombre']) {
                <small class="form-field-error">{{ errores['nombre'] }}</small>
              }</div>
            <div class="form-field" [class.form-field-invalid]="errores['descripcion']">
              <label>Descripción</label><textarea [(ngModel)]="formEstado.descripcion" name="descripcionEstadoCatalogo"
                                                  rows="4" maxlength="255"></textarea>@if (errores['descripcion']) {
              <small class="form-field-error">{{ errores['descripcion'] }}</small>
            }</div>
            <div class="form-field" [class.form-field-invalid]="errores['orden']"><label>Orden</label><input
              type="number" min="1" [(ngModel)]="formEstado.orden" name="ordenEstado" />@if (errores['orden']) {
              <small class="form-field-error">{{ errores['orden'] }}</small>
            }</div>
          }
          <div class="modal-footer">
            <button type="button" class="btn-cancel" (click)="cerrarModal()">Cancelar</button>
            <button type="submit" class="btn-save" [disabled]="guardando">{{ guardando ? 'Guardando...' : 'Guardar' }}
            </button>
          </div>
        </form>
      </div>
    </div>
  }
</div>
