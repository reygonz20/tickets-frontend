  right: 0.75rem;
  background: none;
  border: none;
  color: #3b82f6;
  font-size: 0.76rem;
  font-weight: 600;
  cursor: pointer;
}

@media (max-width: 900px) {
  .perfil-grid {
    grid-template-columns: 1fr;
  }
}

.profile-loading-card,
.profile-error-card {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  padding: 1rem 1.2rem;
  font-size: 0.88rem;
  color: #64748b;
  box-shadow: 0 1px 2px rgba(15, 23, 42, 0.03);
}

.profile-error-card {
  color: #b91c1c;
  border-color: #fecaca;
  background: #fffafa;
}
