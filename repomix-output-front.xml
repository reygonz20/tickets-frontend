<file path="src/app/pages/tecnicos/tecnicos.html">
<div class="tecnicos-page">

  <!-- CABECERA -->
  <div class="page-header">
    <div>
      <p class="page-kicker">EQUIPO DE SOPORTE</p>
      <h1 class="page-title">Técnicos</h1>
      <p class="page-subtitle">Gestiona especialidades, disponibilidad y estado del equipo de soporte.</p>
    </div>

    <div class="header-actions">
      <button type="button" class="btn-secondary" (click)="abrirModalEspecialidades()">
        <span>◎</span>
        <span>Especialidades</span>
      </button>
      <button type="button" class="btn-primary" (click)="abrirModalNuevoTecnico()">
        <span>＋</span>
        <span>Añadir técnico</span>
      </button>
    </div>
  </div>

  <!-- RESUMEN -->
  <div class="summary-grid">
    <div class="summary-card">
      <span class="summary-label">Usuarios con rol técnico</span>
      <strong class="summary-value">{{ totalUsuariosTecnicos }}</strong>
    </div>
    <div class="summary-card">
      <span class="summary-label">Perfiles configurados</span>
      <strong class="summary-value">{{ totalPerfilesConfigurados }}</strong>
    </div>
    <div class="summary-card">
      <span class="summary-label">Disponibles ahora</span>
      <strong class="summary-value">{{ totalDisponibles }}</strong>
    </div>
    <div class="summary-card">
      <span class="summary-label">Pendientes de configurar</span>
      <strong class="summary-value">{{ totalPendientesConfigurar }}</strong>
    </div>
  </div>

  <!-- FILTROS -->
  <div class="table-card filters-card">
    <div class="filters-bar">
      <div class="filter-search">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="text"
          [(ngModel)]="filtroTexto"
          placeholder="Buscar por nombre, correo o especialidad..."
        />
      </div>

      <select [(ngModel)]="filtroEspecialidad" class="filter-select">
        <option value="TODAS">Todas las especialidades</option>
        @for (e of especialidades; track e.idEspecialidad) {
          <option [value]="e.idEspecialidad">{{ e.nombre }}</option>
        }
      </select>

      <select [(ngModel)]="filtroDisponibilidad" class="filter-select">
        <option value="TODAS">Toda disponibilidad</option>
        <option value="DISPONIBLE">Disponible</option>
        <option value="OCUPADO">Ocupado</option>
        <option value="NO_DISPONIBLE">No disponible</option>
      </select>

      <select [(ngModel)]="filtroEstado" class="filter-select">
        <option value="TODOS">Todos los estados</option>
        <option value="ACTIVO">Activo</option>
        <option value="INACTIVO">Inactivo</option>
      </select>
    </div>
  </div>

  <!-- TARJETAS -->
  <div class="tecnicos-grid">
    @for (item of tecnicosFiltrados; track item.usuario.idUsuario) {
      @let u = item.usuario;
      @let t = item.perfil;
      <div class="tech-card" [class.tech-card-inactive]="!(t ? t.estado : u.estado)" [class.tech-card-pending]="!t">

        <div class="tech-card-top">
          <div class="tech-top-left">
            <div class="tech-avatar-lg">{{ obtenerInicialesUsuario(u) }}</div>
            @if (t) {
              <span class="avail-badge" [ngClass]="claseDisponibilidad(t.disponibilidad)">
                <span class="dot"></span>
                {{ formatearDisponibilidad(t.disponibilidad) }}
              </span>
            } @else {
              <span class="avail-badge avail-pending">
                <span class="dot"></span>
                Pendiente de configurar
              </span>
            }
          </div>

          <span class="status-badge" [ngClass]="(t ? t.estado : u.estado) ? 'status-active' : 'status-inactive'">
            <span class="dot"></span>
            {{ (t ? t.estado : u.estado) ? 'Activo' : 'Inactivo' }}
          </span>
        </div>

        <div class="tech-identity">
          <h3 class="tech-name">{{ u.nombres }} {{ u.apellidos }}</h3>
          <p class="tech-email">{{ u.correo }}</p>
          <p class="tech-phone">{{ u.telefono || 'Sin teléfono registrado' }}</p>

          <div class="specialty-pill" [class.specialty-pending]="!t">
            <span class="spec-icon">◎</span>
            <span>{{ t?.especialidad || 'Perfil técnico sin configurar' }}</span>
          </div>
        </div>

        <div class="tech-info-grid">
          <div class="tech-info-item">
            <span class="info-label">Tickets asignados</span>
            <strong>{{ ticketsAsignados(t) }}</strong>
          </div>
          <div class="tech-info-item">
            <span class="info-label">Tickets resueltos</span>
            <strong>{{ ticketsResueltos(t) }}</strong>
          </div>
        </div>

        <div class="tech-card-actions">
          @if (t) {
            <button type="button" class="btn-view-profile" (click)="verPerfil(t)">
              Ver perfil
            </button>

            <button type="button" class="btn-edit-square" title="Editar técnico" (click)="abrirModalEditarTecnico(t)">
              <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
              </svg>
            </button>

            @if (t.estado) {
              <button type="button" class="btn-delete-square" title="Desactivar técnico" (click)="desactivarTecnico(t)">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M3 6h18"></path>
                  <path d="M8 6V4h8v2"></path>
                  <path d="M19 6l-1 14H6L5 6"></path>
                </svg>
              </button>
            }
          } @else {
            <button type="button" class="btn-configure-profile" (click)="configurarUsuarioComoTecnico(u)"
                    [disabled]="!u.estado">
              Configurar perfil técnico
            </button>
          }
        </div>
      </div>
    } @empty {
      <div class="table-card empty-row" style="grid-column: 1 / -1;">
        {{ cargando ? 'Cargando técnicos...' : 'No se encontraron usuarios técnicos con los filtros seleccionados.' }}
      </div>
    }
  </div>

  <!-- MODAL CREAR / EDITAR TÉCNICO -->
  @if (mostrarModalTecnico) {
    <div class="modal-backdrop" (click)="cerrarModalTecnico()">
      <div class="modal-card" (click)="$event.stopPropagation()">
        <div class="modal-header">
          <div>
            <p class="modal-kicker">GESTIÓN DE TÉCNICOS</p>
            <h2 class="modal-title">{{ modoEdicionTecnico ? 'Editar técnico' : 'Añadir técnico' }}</h2>
            <p class="modal-subtitle">
              {{
                modoEdicionTecnico
                  ? 'Actualiza la especialidad, disponibilidad y estado del técnico.'
                  : 'Selecciona un usuario con rol TÉCNICO y completa su perfil de soporte.'
              }}
            </p>
          </div>
          <button type="button" class="btn-close" (click)="cerrarModalTecnico()" title="Cerrar">✕</button>
        </div>

        @if (mensajeErrorTecnico) {
          <div class="modal-alert-error">{{ mensajeErrorTecnico }}</div>
        }

        <form (ngSubmit)="guardarTecnico()" class="modal-form">
          <div class="form-field" [class.form-field-invalid]="erroresTecnico['idUsuario']">
            <label>Usuario técnico</label>
            @if (!modoEdicionTecnico) {
              <select name="idUsuario" [(ngModel)]="formularioTecnico.idUsuario" required>
                <option [ngValue]="0">Seleccionar usuario...</option>
                @for (u of usuariosDisponiblesParaTecnico; track u.idUsuario) {
                  <option [ngValue]="u.idUsuario">
                    {{ u.nombres }} {{ u.apellidos }} · {{ u.correo }}
                  </option>
                }
              </select>
              @if (usuariosDisponiblesParaTecnico.length === 0) {
                <p class="form-help">No hay usuarios activos con rol TÉCNICO pendientes de registrar.</p>
              }
              @if (erroresTecnico['idUsuario']) {
                <small class="form-field-error">{{ erroresTecnico['idUsuario'] }}</small>
              }
            } @else {
              <input type="text" [value]="nombreUsuarioSeleccionado()" disabled />
            }
          </div>

          <div class="form-row-2">
            <div class="form-field" [class.form-field-invalid]="erroresTecnico['idEspecialidad']">
              <label>Especialidad</label>
              <select name="idEspecialidad" [(ngModel)]="formularioTecnico.idEspecialidad" required>
                <option [ngValue]="0">Seleccionar...</option>
                @for (e of especialidadesActivas; track e.idEspecialidad) {
                  <option [ngValue]="e.idEspecialidad">{{ e.nombre }}</option>
                }
              </select>
              @if (erroresTecnico['idEspecialidad']) {
                <small class="form-field-error">{{ erroresTecnico['idEspecialidad'] }}</small>
              }
            </div>

            <div class="form-field" [class.form-field-invalid]="erroresTecnico['disponibilidad']">
              <label>Disponibilidad</label>
              <select name="disponibilidad" [(ngModel)]="formularioTecnico.disponibilidad">
                <option value="DISPONIBLE">Disponible</option>
                <option value="OCUPADO">Ocupado</option>
                <option value="NO_DISPONIBLE">No disponible</option>
              </select>
              @if (erroresTecnico['disponibilidad']) {
                <small class="form-field-error">{{ erroresTecnico['disponibilidad'] }}</small>
              }
            </div>
          </div>

          @if (modoEdicionTecnico) {
            <div class="form-field">
              <label>Estado</label>
              <select name="estado" [(ngModel)]="formularioTecnico.estado">
                <option [ngValue]="true">Activo</option>
                <option [ngValue]="false">Inactivo</option>
              </select>
            </div>
          }

          <div class="modal-footer">
            <button type="button" class="btn-cancel" (click)="cerrarModalTecnico()">Cancelar</button>
            <button type="submit" class="btn-save" [disabled]="guardandoTecnico">
              {{ guardandoTecnico ? 'Guardando...' : (modoEdicionTecnico ? 'Guardar cambios' : 'Registrar técnico') }}
            </button>
          </div>
        </form>
      </div>
    </div>
  }

  <!-- MODAL DETALLE -->
  @if (mostrarModalDetalle) {
    <div class="modal-backdrop" (click)="cerrarModalDetalle()">
      <div class="modal-card modal-card-sm" (click)="$event.stopPropagation()">
        <div class="modal-header">
          <div>
            <p class="modal-kicker">PERFIL TÉCNICO</p>
            <h2 class="modal-title">Detalle del técnico</h2>
            <p class="modal-subtitle">Información obtenida directamente desde técnico-service.</p>
          </div>
          <button type="button" class="btn-close" (click)="cerrarModalDetalle()">✕</button>
        </div>

        @if (cargandoDetalle) {
          <div class="detail-loading">Cargando perfil...</div>
        } @else if (tecnicoDetalle) {
          <div class="detail-profile">
            <div class="detail-avatar">{{ obtenerIniciales(tecnicoDetalle) }}</div>
            <h3>{{ tecnicoDetalle.nombres }} {{ tecnicoDetalle.apellidos }}</h3>
            <p>{{ tecnicoDetalle.correo }}</p>

            <div class="detail-list">
              <div><span>Teléfono</span><strong>{{ tecnicoDetalle.telefono || '—' }}</strong></div>
              <div><span>Especialidad</span><strong>{{ tecnicoDetalle.especialidad }}</strong></div>
              <div>
                <span>Disponibilidad</span><strong>{{ formatearDisponibilidad(tecnicoDetalle.disponibilidad) }}</strong>
              </div>
              <div><span>Estado</span><strong>{{ tecnicoDetalle.estado ? 'Activo' : 'Inactivo' }}</strong></div>
            </div>
          </div>
        }
      </div>
    </div>
  }

  <!-- MODAL ESPECIALIDADES -->
  @if (mostrarModalEspecialidades) {
    <div class="modal-backdrop" (click)="cerrarModalEspecialidades()">
      <div class="modal-card modal-card-wide" (click)="$event.stopPropagation()">
        <div class="modal-header">
          <div>
            <p class="modal-kicker">CONFIGURACIÓN</p>
            <h2 class="modal-title">Especialidades</h2>
            <p class="modal-subtitle">Administra las especialidades disponibles para el equipo técnico.</p>
          </div>
          <button type="button" class="btn-close" (click)="cerrarModalEspecialidades()">✕</button>
        </div>

        <div class="specialty-manager">
          <div class="specialty-form-panel">
            <h3>{{ editandoEspecialidad ? 'Editar especialidad' : 'Nueva especialidad' }}</h3>

            @if (mensajeErrorEspecialidad) {
              <div class="modal-alert-error">{{ mensajeErrorEspecialidad }}</div>
            }

            <form (ngSubmit)="guardarEspecialidad()" class="modal-form">
              <div class="form-field" [class.form-field-invalid]="erroresEspecialidad['nombre']">
                <label>Nombre</label>
                <input
                  type="text"
                  name="nombreEspecialidad"
                  [(ngModel)]="formularioEspecialidad.nombre"
                  placeholder="Ej. Redes"
                  required
                />
                @if (erroresEspecialidad['nombre']) {
                  <small class="form-field-error">{{ erroresEspecialidad['nombre'] }}</small>
                }
              </div>

              <div class="form-field" [class.form-field-invalid]="erroresEspecialidad['descripcion']">
                <label>Descripción</label>
                <textarea
                  name="descripcionEspecialidad"
                  [(ngModel)]="formularioEspecialidad.descripcion"
                  rows="4"
                  placeholder="Describe el enfoque de esta especialidad..."
                  maxlength="255"
                ></textarea>
                @if (erroresEspecialidad['descripcion']) {
                  <small class="form-field-error">{{ erroresEspecialidad['descripcion'] }}</small>
                }
              </div>

              @if (editandoEspecialidad) {
                <div class="form-field">
                  <label>Estado</label>
                  <select name="estadoEspecialidad" [(ngModel)]="formularioEspecialidad.estado">
                    <option [ngValue]="true">Activa</option>
                    <option [ngValue]="false">Inactiva</option>
                  </select>
                </div>
              }

              <div class="specialty-form-actions">
                @if (editandoEspecialidad) {
                  <button type="button" class="btn-cancel" (click)="cancelarEdicionEspecialidad()">Cancelar edición
                  </button>
                }
                <button type="submit" class="btn-save" [disabled]="guardandoEspecialidad">
                  {{ guardandoEspecialidad ? 'Guardando...' : (editandoEspecialidad ? 'Guardar cambios' : 'Crear especialidad') }}
                </button>
              </div>
            </form>
          </div>

          <div class="specialty-list-panel">
            @for (e of especialidades; track e.idEspecialidad) {
              <div class="specialty-row">
                <div>
                  <div class="specialty-row-title">
                    <strong>{{ e.nombre }}</strong>
                    <span class="status-badge" [ngClass]="e.estado ? 'status-active' : 'status-inactive'">
                      <span class="dot"></span>
                      {{ e.estado ? 'Activa' : 'Inactiva' }}
                    </span>
                  </div>
                  <p>{{ e.descripcion || 'Sin descripción' }}</p>
                </div>

                <div class="specialty-actions">
                  <button type="button" class="btn-edit-square" (click)="editarEspecialidad(e)" title="Editar">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
                    </svg>
                  </button>
                  @if (e.estado) {
                    <button type="button" class="btn-delete-square" (click)="desactivarEspecialidad(e)"
                            title="Desactivar">
                      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                           stroke-width="2">
                        <path d="M3 6h18"></path>
                        <path d="M8 6V4h8v2"></path>
                        <path d="M19 6l-1 14H6L5 6"></path>
                      </svg>
                    </button>
                  }
                </div>
              </div>
            } @empty {
              <div class="empty-specialties">No hay especialidades registradas.</div>
            }
          </div>
        </div>
      </div>
    </div>
  }

</div>
</file>

<file path="src/app/pages/tecnicos/tecnicos.ts">
import { ChangeDetectorRef, Component, OnInit, inject } from '@angular/core';
import { CommonModule } from '@angular/common';
import { FormsModule } from '@angular/forms';
import { TecnicoService } from '../../services/tecnico.service';
import { UsuarioService } from '../../services/usuario.service';
import { TicketService } from '../../services/ticket.service';
import { Usuario } from '../../models/auth.model';
import { TecnicoEstadistica } from '../../models/ticket.model';
import {
  ActualizarEspecialidadRequest,
  ActualizarTecnicoRequest,
  EspecialidadItem,
  NuevaEspecialidadRequest,
  NuevoTecnicoRequest,
  TecnicoItem,
} from '../../models/tecnico.model';

@Component({
  selector: 'app-tecnicos',
  standalone: true,
  imports: [CommonModule, FormsModule],
  templateUrl: './tecnicos.html',
  styleUrl: './tecnicos.css',
})
export class Tecnicos implements OnInit {
  private readonly tecnicoService = inject(TecnicoService);
  private readonly usuarioService = inject(UsuarioService);
  private readonly ticketService = inject(TicketService);
  private readonly cdr = inject(ChangeDetectorRef);

  tecnicos: TecnicoItem[] = [];
  usuariosTecnicos: Usuario[] = [];
  especialidades: EspecialidadItem[] = [];
  especialidadesActivas: EspecialidadItem[] = [];

  cargando: boolean = false;
  totalActivos: number = 0;
  totalDisponibles: number = 0;
  estadisticas = new Map<number, TecnicoEstadistica>();

  filtroTexto: string = '';
  filtroEspecialidad: string = 'TODAS';
  filtroDisponibilidad: string = 'TODAS';
  filtroEstado: string = 'TODOS';

  // Modal técnico
  mostrarModalTecnico: boolean = false;
  modoEdicionTecnico: boolean = false;
  idTecnicoEditar: number | null = null;
  guardandoTecnico: boolean = false;
  mensajeErrorTecnico: string = '';
  erroresTecnico: Record<string, string> = {};

  formularioTecnico: NuevoTecnicoRequest & { estado?: boolean } = {
    idUsuario: 0,
    idEspecialidad: 0,
    disponibilidad: 'DISPONIBLE',
    estado: true,
  };

  // Modal detalle
  mostrarModalDetalle: boolean = false;
  tecnicoDetalle: TecnicoItem | null = null;
  cargandoDetalle: boolean = false;

  // Modal especialidades
  mostrarModalEspecialidades: boolean = false;
  editandoEspecialidad: boolean = false;
  idEspecialidadEditar: number | null = null;
  guardandoEspecialidad: boolean = false;
  mensajeErrorEspecialidad: string = '';
  erroresEspecialidad: Record<string, string> = {};

  formularioEspecialidad: NuevaEspecialidadRequest & { estado?: boolean } = {
    nombre: '',
    descripcion: '',
    estado: true,
  };

  ngOnInit(): void {
    this.cargarDatos();
  }

  cargarDatos(): void {
    this.cargando = true;

    this.tecnicoService.listarTecnicos().subscribe({
      next: (res) => {
        this.cargando = false;
        if (res.rpta === 1 && res.body) {
          this.tecnicos = res.body;
          this.cargarEstadisticasTecnicos();
        }
        this.cdr.detectChanges();
      },
      error: () => {
        this.cargando = false;
        this.cdr.detectChanges();
      },
    });

    this.tecnicoService.listarTecnicosActivos().subscribe({
      next: (res) => {
        this.totalActivos = res.rpta === 1 && res.body ? res.body.length : 0;
        this.cdr.detectChanges();
      },
    });

    this.tecnicoService.listarTecnicosDisponibles().subscribe({
      next: (res) => {
        this.totalDisponibles = res.rpta === 1 && res.body ? res.body.length : 0;
        this.cdr.detectChanges();
      },
    });

    this.cargarEspecialidades();
    this.cargarUsuariosTecnicos();
  }

  cargarEspecialidades(): void {
    this.tecnicoService.listarEspecialidades().subscribe({
      next: (res) => {
        if (res.rpta === 1 && res.body) {
          this.especialidades = res.body;
        }
        this.cdr.detectChanges();
      },
    });

    this.tecnicoService.listarEspecialidadesActivas().subscribe({
      next: (res) => {
        if (res.rpta === 1 && res.body) {
          this.especialidadesActivas = res.body;
        }
        this.cdr.detectChanges();
      },
    });
  }

  cargarUsuariosTecnicos(): void {
    this.usuarioService.listarUsuarios().subscribe({
      next: (res) => {
        if (res.rpta === 1 && res.body) {
          this.usuariosTecnicos = res.body.filter((u) => u.rol === 'TECNICO' && u.estado);
        }
        this.cdr.detectChanges();
      },
    });
  }

  get filasTecnicos(): Array<{ usuario: Usuario; perfil: TecnicoItem | null }> {
    const perfilesPorUsuario = new Map(this.tecnicos.map((t) => [t.idUsuario, t]));

    const desdeUsuarios = this.usuariosTecnicos.map((usuario) => ({
      usuario,
      perfil: perfilesPorUsuario.get(usuario.idUsuario) || null,
    }));

    const idsUsuarios = new Set(this.usuariosTecnicos.map((u) => u.idUsuario));
    const huerfanos = this.tecnicos
      .filter((t) => !idsUsuarios.has(t.idUsuario))
      .map((t) => ({
        usuario: {
          idUsuario: t.idUsuario,
          nombres: t.nombres,
          apellidos: t.apellidos,
          correo: t.correo,
          telefono: t.telefono || '',
          rol: 'TECNICO',
          estado: t.estado,
          fechaCreacion: '',
        } as Usuario,
        perfil: t,
      }));

    return [...desdeUsuarios, ...huerfanos];
  }

  get tecnicosFiltrados(): Array<{ usuario: Usuario; perfil: TecnicoItem | null }> {
    return this.filasTecnicos.filter((item) => {
      const u = item.usuario;
      const t = item.perfil;
      const termino = this.filtroTexto.trim().toLowerCase();
      const nombre = `${u.nombres} ${u.apellidos}`.toLowerCase();
      const correo = (u.correo || '').toLowerCase();
      const especialidad = (t?.especialidad || '').toLowerCase();

      const coincideTexto =
        !termino ||
        nombre.includes(termino) ||
        correo.includes(termino) ||
        especialidad.includes(termino);

      const coincideEspecialidad =
        this.filtroEspecialidad === 'TODAS' ||
        (!!t && String(t.idEspecialidad) === this.filtroEspecialidad);

      const coincideDisponibilidad =
        this.filtroDisponibilidad === 'TODAS' ||
        (!!t && (t.disponibilidad || '').toUpperCase() === this.filtroDisponibilidad);

      const activo = t ? t.estado : u.estado;
      const coincideEstado =
        this.filtroEstado === 'TODOS' ||
        (this.filtroEstado === 'ACTIVO' && activo) ||
        (this.filtroEstado === 'INACTIVO' && !activo);

      return coincideTexto && coincideEspecialidad && coincideDisponibilidad && coincideEstado;
    });
  }

  get totalUsuariosTecnicos(): number {
    return this.usuariosTecnicos.length;
  }

  get totalPerfilesConfigurados(): number {
    return this.tecnicos.length;
  }

  get totalPendientesConfigurar(): number {
    return this.usuariosDisponiblesParaTecnico.length;
  }

  get usuariosDisponiblesParaTecnico(): Usuario[] {
    const idsYaRegistrados = new Set(this.tecnicos.map((t) => t.idUsuario));
    return this.usuariosTecnicos.filter((u) => !idsYaRegistrados.has(u.idUsuario));
  }

  cargarEstadisticasTecnicos(): void {
    this.estadisticas.clear();
    this.tecnicos.forEach((t) => {
      this.ticketService.obtenerEstadisticaTecnico(t.idTecnico).subscribe({
        next: (e) => {
          this.estadisticas.set(t.idTecnico, e);
          this.cdr.detectChanges();
        },
        error: () => {
          this.estadisticas.set(t.idTecnico, {
            idTecnico: t.idTecnico,
            asignados: 0,
            resueltos: 0,
          });
        },
      });
    });
  }

  ticketsAsignados(t: TecnicoItem | null): number {
    return t ? this.estadisticas.get(t.idTecnico)?.asignados || 0 : 0;
  }

  ticketsResueltos(t: TecnicoItem | null): number {
    return t ? this.estadisticas.get(t.idTecnico)?.resueltos || 0 : 0;
  }

  nombreUsuarioSeleccionado(): string {
    const u = this.usuariosTecnicos.find((x) => x.idUsuario === this.formularioTecnico.idUsuario);
    return u ? `${u.nombres} ${u.apellidos}` : 'Usuario técnico';
  }

  obtenerIniciales(t: TecnicoItem): string {
    const n = t.nombres ? t.nombres.trim()[0] : 'T';
    const a = t.apellidos ? t.apellidos.trim()[0] : '';
    return (n + a).toUpperCase();
  }

  obtenerInicialesUsuario(u: Usuario): string {
    const n = u.nombres ? u.nombres.trim()[0] : 'T';
    const a = u.apellidos ? u.apellidos.trim()[0] : '';
    return (n + a).toUpperCase();
  }

  configurarUsuarioComoTecnico(u: Usuario): void {
    this.modoEdicionTecnico = false;
    this.idTecnicoEditar = null;
    this.mensajeErrorTecnico = '';
    this.erroresTecnico = {};
    this.formularioTecnico = {
      idUsuario: u.idUsuario,
      idEspecialidad: this.especialidadesActivas[0]?.idEspecialidad || 0,
      disponibilidad: 'DISPONIBLE',
      estado: true,
    };
    this.mostrarModalTecnico = true;
  }

  esDisponible(t: TecnicoItem): boolean {
    return (t.disponibilidad || '').toUpperCase() === 'DISPONIBLE';
  }

  formatearDisponibilidad(valor: string): string {
    const normalizado = (valor || '').toUpperCase();
    if (normalizado === 'DISPONIBLE') return 'Disponible';
    if (normalizado === 'OCUPADO') return 'Ocupado';
    if (normalizado === 'NO_DISPONIBLE') return 'No disponible';
    return valor || 'Sin definir';
  }

  claseDisponibilidad(valor: string): string {
    const normalizado = (valor || '').toUpperCase();
    if (normalizado === 'DISPONIBLE') return 'avail-online';
    if (normalizado === 'OCUPADO') return 'avail-busy';
    return 'avail-offline';
  }

  // =========================
  // TÉCNICOS
  // =========================

  abrirModalNuevoTecnico(): void {
    this.modoEdicionTecnico = false;
    this.idTecnicoEditar = null;
    this.mensajeErrorTecnico = '';
    this.erroresTecnico = {};
    this.formularioTecnico = {
      idUsuario: 0,
      idEspecialidad: this.especialidadesActivas[0]?.idEspecialidad || 0,
      disponibilidad: 'DISPONIBLE',
      estado: true,
    };
    this.mostrarModalTecnico = true;
  }

  abrirModalEditarTecnico(t: TecnicoItem): void {
    this.modoEdicionTecnico = true;
    this.idTecnicoEditar = t.idTecnico;
    this.mensajeErrorTecnico = '';
    this.formularioTecnico = {
      idUsuario: t.idUsuario,
      idEspecialidad: t.idEspecialidad,
      disponibilidad: t.disponibilidad,
      estado: t.estado,
    };
    this.mostrarModalTecnico = true;
  }

  cerrarModalTecnico(): void {
    this.mostrarModalTecnico = false;
  }

  guardarTecnico(): void {
    this.mensajeErrorTecnico = '';
    this.erroresTecnico = {};

    if (!this.modoEdicionTecnico && !this.formularioTecnico.idUsuario) {
      this.erroresTecnico['idUsuario'] = 'Debes seleccionar un usuario técnico activo.';
    }
    if (!this.formularioTecnico.idEspecialidad) {
      this.erroresTecnico['idEspecialidad'] = 'Debes seleccionar una especialidad.';
    }
    if (!this.formularioTecnico.disponibilidad) {
      this.erroresTecnico['disponibilidad'] = 'Debes seleccionar la disponibilidad.';
    }
    if (Object.keys(this.erroresTecnico).length) return;

    this.guardandoTecnico = true;

    if (!this.modoEdicionTecnico) {
      const dto: NuevoTecnicoRequest = {
        idUsuario: this.formularioTecnico.idUsuario,
        idEspecialidad: this.formularioTecnico.idEspecialidad,
        disponibilidad: this.formularioTecnico.disponibilidad,
      };

      this.tecnicoService.crearTecnico(dto).subscribe({
        next: (res) => {
          this.guardandoTecnico = false;
          if (res.rpta === 1) {
            this.mostrarModalTecnico = false;
            this.cargarDatos();
          } else {
            this.mensajeErrorTecnico = res.mensaje;
          }
          this.cdr.detectChanges();
        },
        error: (err) => {
          this.guardandoTecnico = false;
          this.mensajeErrorTecnico = err.error?.mensaje || 'Error al registrar el técnico.';
          this.cdr.detectChanges();
        },
      });
      return;
    }

    if (this.idTecnicoEditar !== null) {
      const dto: ActualizarTecnicoRequest = {
        idEspecialidad: this.formularioTecnico.idEspecialidad,
        disponibilidad: this.formularioTecnico.disponibilidad,
        estado: this.formularioTecnico.estado,
      };

      this.tecnicoService.actualizarTecnico(this.idTecnicoEditar, dto).subscribe({
        next: (res) => {
          this.guardandoTecnico = false;
          if (res.rpta === 1) {
            this.mostrarModalTecnico = false;
            this.cargarDatos();
          } else {
            this.mensajeErrorTecnico = res.mensaje;
          }
          this.cdr.detectChanges();
        },
        error: (err) => {
          this.guardandoTecnico = false;
          this.mensajeErrorTecnico = err.error?.mensaje || 'Error al actualizar el técnico.';
          this.cdr.detectChanges();
        },
      });
    }
  }

  desactivarTecnico(t: TecnicoItem): void {
    if (!confirm(`¿Deseas desactivar a ${t.nombres} ${t.apellidos} como técnico?`)) {
      return;
    }

    this.tecnicoService.desactivarTecnico(t.idTecnico).subscribe({
      next: (res) => {
        if (res.rpta === 1) {
          this.cargarDatos();
        }
      },
      error: (err) => {
        alert(err.error?.mensaje || 'No se pudo desactivar el técnico.');
      },
    });
  }

  verPerfil(t: TecnicoItem): void {
    this.cargandoDetalle = true;
    this.tecnicoDetalle = null;
    this.mostrarModalDetalle = true;

    this.tecnicoService.obtenerTecnicoPorId(t.idTecnico).subscribe({
      next: (res) => {
        this.cargandoDetalle = false;
        if (res.rpta === 1 && res.body) {
          this.tecnicoDetalle = res.body;
        }
        this.cdr.detectChanges();
      },
      error: () => {
        this.cargandoDetalle = false;
        this.cdr.detectChanges();
      },
    });
  }

  cerrarModalDetalle(): void {
    this.mostrarModalDetalle = false;
    this.tecnicoDetalle = null;
  }

  // =========================
  // ESPECIALIDADES
  // =========================

  abrirModalEspecialidades(): void {
    this.cancelarEdicionEspecialidad();
    this.mostrarModalEspecialidades = true;
  }

  cerrarModalEspecialidades(): void {
    this.mostrarModalEspecialidades = false;
    this.cancelarEdicionEspecialidad();
  }

  editarEspecialidad(e: EspecialidadItem): void {
    this.editandoEspecialidad = true;
    this.idEspecialidadEditar = e.idEspecialidad;
    this.mensajeErrorEspecialidad = '';
    this.erroresEspecialidad = {};
    this.formularioEspecialidad = {
      nombre: e.nombre,
      descripcion: e.descripcion || '',
      estado: e.estado,
    };
  }

  cancelarEdicionEspecialidad(): void {
    this.editandoEspecialidad = false;
    this.idEspecialidadEditar = null;
    this.mensajeErrorEspecialidad = '';
    this.erroresEspecialidad = {};
    this.formularioEspecialidad = {
      nombre: '',
      descripcion: '',
      estado: true,
    };
  }

  guardarEspecialidad(): void {
    this.mensajeErrorEspecialidad = '';
    this.erroresEspecialidad = {};

    const nombre = this.formularioEspecialidad.nombre.trim();
    const descripcion = (this.formularioEspecialidad.descripcion || '').trim();
    if (!nombre)
      this.erroresEspecialidad['nombre'] = 'El nombre de la especialidad es obligatorio.';
    else if (nombre.length > 100) this.erroresEspecialidad['nombre'] = 'Máximo 100 caracteres.';
    if (descripcion.length > 255)
      this.erroresEspecialidad['descripcion'] = 'Máximo 255 caracteres.';
    if (Object.keys(this.erroresEspecialidad).length) return;

    this.guardandoEspecialidad = true;

    if (!this.editandoEspecialidad) {
      const dto: NuevaEspecialidadRequest = {
        nombre: this.formularioEspecialidad.nombre.trim(),
        descripcion: this.formularioEspecialidad.descripcion?.trim(),
      };

      this.tecnicoService.crearEspecialidad(dto).subscribe({
        next: (res) => {
          this.guardandoEspecialidad = false;
          if (res.rpta === 1) {
            this.cancelarEdicionEspecialidad();
            this.cargarEspecialidades();
          } else {
            this.mensajeErrorEspecialidad = res.mensaje;
          }
          this.cdr.detectChanges();
        },
        error: (err) => {
          this.guardandoEspecialidad = false;
          this.mensajeErrorEspecialidad = err.error?.mensaje || 'Error al crear la especialidad.';
          this.cdr.detectChanges();
        },
      });
      return;
    }

    if (this.idEspecialidadEditar !== null) {
      const dto: ActualizarEspecialidadRequest = {
        nombre: this.formularioEspecialidad.nombre.trim(),
        descripcion: this.formularioEspecialidad.descripcion?.trim(),
        estado: this.formularioEspecialidad.estado,
      };

      this.tecnicoService.actualizarEspecialidad(this.idEspecialidadEditar, dto).subscribe({
        next: (res) => {
          this.guardandoEspecialidad = false;
          if (res.rpta === 1) {
            this.cancelarEdicionEspecialidad();
            this.cargarEspecialidades();
            this.cargarDatos();
          } else {
            this.mensajeErrorEspecialidad = res.mensaje;
          }
          this.cdr.detectChanges();
        },
        error: (err) => {
          this.guardandoEspecialidad = false;
          this.mensajeErrorEspecialidad =
            err.error?.mensaje || 'Error al actualizar la especialidad.';
          this.cdr.detectChanges();
        },
      });
    }
  }

  desactivarEspecialidad(e: EspecialidadItem): void {
    if (!confirm(`¿Deseas desactivar la especialidad ${e.nombre}?`)) {
      return;
    }

    this.tecnicoService.desactivarEspecialidad(e.idEspecialidad).subscribe({
      next: (res) => {
        if (res.rpta === 1) {
          this.cancelarEdicionEspecialidad();
          this.cargarEspecialidades();
          this.cargarDatos();
        }
      },
      error: (err) => {
        this.mensajeErrorEspecialidad =
          err.error?.mensaje || 'No se pudo desactivar la especialidad.';
        this.cdr.detectChanges();
      },
    });
  }
}
</file>

<file path="src/app/pages/tickets/tickets.css">
:host {
  display: block;
}

/* Mantiene el sistema visual original del proyecto y solo añade estilos propios del módulo. */
.filter-search {
  width: 320px;
}

.ticket-filters {
  align-items: center;
}

.ticket-filters .filter-search {
  margin-right: auto;
}

.ticket-table-scroll {
  max-height: calc(100vh - 350px);
}

.table-meta-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1.5rem;
  border-bottom: 1px solid #f1f5f9;
  font-size: 0.8rem;
  color: #64748b;
  background: #ffffff;
}

.loading-text {
  color: #3b82f6;
  font-weight: 600;
}

.tickets-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  min-width: 1120px;
}

.tickets-table thead th {
  position: sticky;
  top: 0;
  z-index: 10;
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: #94a3b8;
  padding: 0.85rem 1.5rem;
  border-bottom: 1px solid #f1f5f9;
  background-color: #fafcfe;
}

.tickets-table tbody tr {
  border-bottom: 1px solid #f1f5f9;
  transition: background-color 0.15s ease;
}

.tickets-table tbody tr:hover {
  background-color: #f8fafc;
}

.row-critical {
  border-left: 3px solid #ef4444;
  background: linear-gradient(90deg, rgba(254, 242, 242, 0.55) 0%, rgba(255, 255, 255, 0) 35%);
}

.tickets-table tbody td {
  padding: 0.95rem 1.5rem;
  font-size: 0.84rem;
  vertical-align: middle;
}

.ticket-main-cell {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.ticket-code {
  font-size: 0.78rem;
  font-weight: 700;
  color: #2563eb;
}

.ticket-title {
  font-weight: 600;
  color: #0f172a;
}

.category-cell,
.tech-cell {
  display: flex;
  align-items: center;
  gap: 0.55rem;
  color: #334155;
  font-weight: 500;
}

.category-box {
  width: 26px;
  height: 26px;
  border-radius: 7px;
  background: #f1f5f9;
  color: #3b82f6;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.tech-avatar {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: #dbeafe;
  color: #2563eb;
  font-size: 0.72rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.unassigned-text {
  color: #94a3b8;
  font-style: italic;
}

.badge-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  padding: 0.25rem 0.65rem;
  border-radius: 999px;
  font-size: 0.74rem;
  font-weight: 600;
}

.prio-critica {
  background: #fee2e2;
  color: #dc2626;
}

.prio-critica .dot {
  background: #ef4444;
}

.prio-alta {
  background: #ffedd5;
  color: #ea580c;
}

.prio-alta .dot {
  background: #f97316;
}

.prio-media {
  background: #fef3c7;
  color: #d97706;
}

.prio-media .dot {
  background: #f59e0b;
}

.prio-baja {
  background: #e0e7ff;
  color: #4f46e5;
}

.prio-baja .dot {
  background: #6366f1;
}

.est-progreso {
  background: #ccfbf1;
  color: #0f766e;
}

.est-progreso .dot {
  background: #14b8a6;
}

.est-asignado, .est-abierto {
  background: #dbeafe;
  color: #1d4ed8;
}

.est-asignado .dot, .est-abierto .dot {
  background: #3b82f6;
}

.est-pendiente {
  background: #fef3c7;
  color: #b45309;
}

.est-pendiente .dot {
  background: #f59e0b;
}

.est-resuelto {
  background: #dcfce7;
  color: #15803d;
}

.est-resuelto .dot {
  background: #22c55e;
}

.est-cerrado {
  background: #f1f5f9;
  color: #475569;
}

.est-cerrado .dot {
  background: #64748b;
}

.row-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 0.4rem;
  white-space: nowrap;
}

.row-action-btn {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 0.35rem 0.62rem;
  color: #475569;
  font-size: 0.74rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s ease;
}

.row-action-btn:hover {
  background: #f8fafc;
  color: #0f172a;
  border-color: #cbd5e1;
}

.row-action-primary {
  color: #2563eb;
  border-color: #bfdbfe;
}

.row-action-primary:hover {
  background: #eff6ff;
  color: #1d4ed8;
  border-color: #93c5fd;
}

.page-alert {
  margin-bottom: 1rem;
  padding: 0.8rem 1rem;
  border-radius: 12px;
  font-size: 0.82rem;
  font-weight: 500;
}

.page-alert-success {
  background: #ecfdf5;
  border: 1px solid #a7f3d0;
  color: #047857;
}

.page-alert-error {
  background: #fef2f2;
  border: 1px solid #fecaca;
  color: #dc2626;
}

/* Detalle: conserva la estética de los modales de Usuarios, ampliando solo el lienzo. */
.ticket-detail-modal {
  max-width: 1080px;
  max-height: 90vh;
  overflow-y: auto;
  padding: 2rem 2.1rem 1.8rem;
}

.ticket-detail-header {
  margin-bottom: 1.35rem;
}

.ticket-detail-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(310px, 0.75fr);
  gap: 1.25rem;
  align-items: start;
}

.ticket-detail-main,
.ticket-detail-side {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.detail-section-card,
.detail-side-card {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  padding: 1.15rem 1.25rem;
}

.detail-section-card h3,
.detail-side-card > h3,
.detail-section-heading h3 {
  margin: 0;
  color: #0f172a;
  font-size: 0.95rem;
  font-weight: 700;
}

.detail-section-card > p,
.solution-card p {
  margin: 0.65rem 0 0;
  color: #475569;
  font-size: 0.86rem;
  line-height: 1.65;
}

.solution-card {
  display: flex;
  align-items: flex-start;
  gap: 0.85rem;
  background: #f0fdf4;
  border-color: #bbf7d0;
}

.detail-section-icon {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  flex: 0 0 34px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

.solution-icon {
  background: #dcfce7;
  color: #15803d;
}

.detail-section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 0.25rem;
}

.detail-section-heading p {
  margin: 0.25rem 0 0;
  color: #94a3b8;
  font-size: 0.76rem;
}

.detail-section-heading > span {
  color: #94a3b8;
  font-size: 0.74rem;
  white-space: nowrap;
}

.comments-list {
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}

.comment-item {
  display: flex;
  align-items: flex-start;
  gap: 0.8rem;
  padding: 0.9rem 1rem;
  border: 1px solid #f1f5f9;
  background: #fafcfe;
  border-radius: 14px;
}

.comment-avatar {
  width: 34px;
  height: 34px;
  border-radius: 10px;
  flex: 0 0 34px;
  background: linear-gradient(135deg, #e0e7ff 0%, #dbeafe 100%);
  color: #2563eb;
  font-size: 0.68rem;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.comment-content {
  min-width: 0;
  flex: 1;
}

.comment-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  margin-bottom: 0.3rem;
}

.comment-meta strong {
  color: #334155;
  font-size: 0.78rem;
}

.comment-meta span {
  color: #94a3b8;
  font-size: 0.7rem;
}

.comment-content p {
  margin: 0;
  color: #475569;
  font-size: 0.82rem;
  line-height: 1.5;
}

.comment-composer {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.75rem;
  align-items: end;
}

.comment-composer textarea {
  width: 100%;
  min-height: 76px;
  padding: 0.75rem 0.95rem;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  background: #fafcfe;
  color: #0f172a;
  font: inherit;
  font-size: 0.84rem;
  outline: none;
  resize: vertical;
}

.comment-composer textarea:focus {
  background: #ffffff;
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
}

.attachment-heading {
  margin-top: 0.4rem;
}

.attachment-list {
  display: flex;
  flex-direction: column;
  gap: 0.65rem;
}

.attachment-item {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.85rem 1rem;
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  background: #ffffff;
}

.attachment-icon {
  width: 32px;
  height: 32px;
  flex: 0 0 32px;
  border-radius: 9px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #eff6ff;
  color: #2563eb;
  font-weight: 700;
}

.attachment-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 0.12rem;
}

.attachment-copy strong {
  color: #334155;
  font-size: 0.8rem;
}

.attachment-copy span {
  color: #64748b;
  font-size: 0.72rem;
}

.attachment-copy small {
  color: #94a3b8;
  font-size: 0.69rem;
  overflow-wrap: anywhere;
}

.attachment-register-card {
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  padding: 1rem;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  background: #f8fafc;
}

.attachment-actions {
  display: flex;
  justify-content: flex-end;
}

.detail-side-card {
  padding: 1rem 1.15rem;
}

.detail-side-card > h3 {
  margin-bottom: 0.65rem;
}

.detail-info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  padding: 0.72rem 0;
  border-bottom: 1px solid #f1f5f9;
  font-size: 0.78rem;
}

.detail-info-row:last-child {
  border-bottom: none;
}

.detail-info-row span {
  color: #64748b;
}

.detail-info-row strong {
  color: #0f172a;
  font-size: 0.78rem;
  text-align: right;
  max-width: 60%;
}

.side-heading {
  margin: 0 0 0.85rem;
}

.timeline {
  display: flex;
  flex-direction: column;
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 16px 1fr;
  gap: 0.55rem;
  padding-bottom: 1rem;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: 5px;
  top: 11px;
  bottom: 0;
  width: 1px;
  background: #e2e8f0;
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-dot {
  width: 11px;
  height: 11px;
  margin-top: 3px;
  border-radius: 50%;
  background: #3b82f6;
  box-shadow: 0 0 0 3px #eff6ff;
  z-index: 1;
}

.timeline-copy strong {
  color: #0f172a;
  font-size: 0.75rem;
  text-transform: capitalize;
}

.timeline-copy p {
  margin: 0.25rem 0;
  color: #64748b;
  font-size: 0.72rem;
  line-height: 1.45;
}

.timeline-copy small {
  color: #94a3b8;
  font-size: 0.68rem;
}

.detail-empty {
  padding: 1rem;
  border: 1px dashed #cbd5e1;
  border-radius: 12px;
  color: #94a3b8;
  text-align: center;
  font-size: 0.78rem;
  background: #fafcfe;
}

@media (max-width: 980px) {
  .ticket-filters {
    align-items: stretch;
  }

  .ticket-detail-grid {
    grid-template-columns: 1fr;
  }

  .ticket-detail-modal {
    max-width: 720px;
  }
}

@media (max-width: 720px) {
  .comment-composer {
    grid-template-columns: 1fr;
  }

  .comment-composer .btn-save {
    justify-self: flex-end;
  }

  .ticket-detail-modal {
    padding: 1.5rem;
  }
}

.closed-ticket-notice {
  margin-top: 1rem;
  padding: 1rem 1.1rem;
  border-radius: 14px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  color: #475569;
}

.closed-ticket-notice strong {
  display: block;
  color: #0f172a;
  margin-bottom: .25rem;
}

.comment-role {
  padding: .15rem .45rem;
  border-radius: 999px;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: .68rem;
  font-weight: 700;
}

.timeline-user {
  color: #64748b;
  font-size: .75rem;
  margin-top: .15rem;
}
</file>

<file path="src/app/pages/tickets/tickets.html">
<div class="tickets-page">
  <div class="page-header">
    <div>
      <p class="page-kicker">GESTIÓN DE TICKETS</p>
      <h1 class="page-title">{{ tituloPagina }}</h1>
      <p class="page-subtitle">{{ subtituloPagina }}</p>
    </div>
    @if (esAdmin || esUsuario) {
      <button type="button" class="btn-primary" (click)="abrirNuevoTicket()"><span>＋</span><span>Nuevo ticket</span>
      </button>
    }
  </div>

  @if (mensaje) {
    <div class="page-alert page-alert-success">{{ mensaje }}</div>
  }
  @if (error) {
    <div class="page-alert page-alert-error">{{ error }}</div>
  }

  <div class="table-card">
    <div class="filters-bar ticket-filters">
      <div class="filter-search">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" [(ngModel)]="filtroTexto" placeholder="Buscar por código, título, usuario o técnico..." />
      </div>
      <select [(ngModel)]="filtroEstado" class="filter-select">
        <option value="TODOS">Todos los estados</option>@for (e of estados; track e.idEstado) {
        <option [value]="e.nombre">{{ formatearEstado(e.nombre) }}</option>
      }</select>
      <select [(ngModel)]="filtroPrioridad" class="filter-select">
        <option value="TODAS">Todas las prioridades</option>@for (p of prioridades; track p.idPrioridad) {
        <option [value]="p.nombre">{{ formatearPrioridad(p.nombre) }}</option>
      }</select>
      <select [(ngModel)]="filtroCategoria" class="filter-select">
        <option value="TODAS">Todas las categorías</option>@for (c of categorias; track c.idCategoria) {
        <option [value]="c.nombre">{{ c.nombre }}</option>
      }</select>
    </div>

    <div class="table-meta-bar"><span
      class="meta-count">Mostrando <strong>{{ ticketsFiltrados.length }}</strong> de {{ tickets.length }}
      tickets</span>@if (cargando) {
      <span class="loading-text">Cargando...</span>
    }</div>

    <div class="table-responsive ticket-table-scroll">
      <table class="tickets-table">
        <thead>
        <tr>
          <th>TICKET</th>
          <th>SOLICITANTE</th>
          <th>CATEGORÍA</th>
          <th>PRIORIDAD</th>
          <th>ESTADO</th>
          <th>TÉCNICO</th>
          <th>ACTUALIZADO</th>
          <th class="text-right"></th>
        </tr>
        </thead>
        <tbody>
          @for (t of ticketsFiltrados; track t.idTicket) {
            <tr [class.row-critical]="esCritica(t.prioridad)">
              <td>
                <div class="ticket-main-cell"><span class="ticket-code">{{ t.codigoTicket }}</span><span
                  class="ticket-title">{{ t.titulo }}</span></div>
              </td>
              <td class="text-muted">{{ t.usuarioCreador || 'Usuario' }}</td>
              <td>
                <div class="category-cell"><span class="category-box"><svg viewBox="0 0 24 24" width="14" height="14"
                                                                           fill="none" stroke="currentColor"
                                                                           stroke-width="2"><path
                  d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg></span><span>{{ t.categoria }}</span>
                </div>
              </td>
              <td><span class="badge-pill"
                        [ngClass]="{'prio-critica':esCritica(t.prioridad),'prio-alta':t.prioridad==='ALTA','prio-media':t.prioridad==='MEDIA','prio-baja':t.prioridad==='BAJA'}"><span
                class="dot"></span>{{ formatearPrioridad(t.prioridad) }}</span></td>
              <td><span class="badge-pill"
                        [ngClass]="{'est-progreso':t.estado==='EN_PROCESO','est-asignado':t.estado==='ASIGNADO','est-abierto':t.estado==='CREADO','est-pendiente':t.estado==='PENDIENTE','est-resuelto':t.estado==='RESUELTO','est-cerrado':t.estado==='CERRADO'||t.estado==='CANCELADO'}"><span
                class="dot"></span>{{ formatearEstado(t.estado) }}</span></td>
              <td>@if (t.tecnicoAsignado) {
                <div class="tech-cell">
                  <div class="tech-avatar">{{ obtenerIniciales(t.tecnicoAsignado) }}</div>
                  <span>{{ t.tecnicoAsignado }}</span></div>
              } @else {
                <span class="unassigned-text">Sin asignar</span>
              }</td>
              <td class="text-muted">{{ (t.fechaActualizacion || t.fechaCreacion) | date:'d MMM yyyy, HH:mm' }}</td>
              <td class="text-right">
                <div class="row-actions">
                  <button type="button" class="row-action-btn row-action-primary" (click)="verDetalle(t)">Ver</button>
                  @if (puedeAsignar(t)) {
                    <button type="button" class="row-action-btn" (click)="abrirAsignar(t)">Asignar</button>
                  }
                  @if (puedeGestionarEstado(t)) {
                    <button type="button" class="row-action-btn"
                            (click)="abrirCambiarEstado(t)">{{ esAdmin && esCerrado(t) ? 'Reabrir' : 'Estado' }}
                    </button>
                  }
                  @if (puedeEditar(t)) {
                    <button type="button" class="btn-icon-edit" (click)="abrirEditar(t)" title="Editar ticket">
                      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor"
                           stroke-width="2">
                        <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
                      </svg>
                    </button>
                  }
                </div>
              </td>
            </tr>
          } @empty {
            <tr>
              <td colspan="8" class="empty-row">No se encontraron tickets con los filtros seleccionados.</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

@if (mostrarModalFormulario) {
  <div class="modal-backdrop" (click)="mostrarModalFormulario = false">
    <div class="modal-card" (click)="$event.stopPropagation()">
      <div class="modal-header">
        <div><p class="modal-kicker">GESTIÓN DE TICKETS</p>
          <h2 class="modal-title">{{ editando ? 'Editar ticket' : 'Crear nuevo ticket' }}</h2>
          <p
            class="modal-subtitle">{{ editando ? 'Actualiza los datos principales de la solicitud.' : 'Registra una nueva solicitud para el equipo de soporte.' }}</p>
        </div>
        <button type="button" class="btn-close" (click)="mostrarModalFormulario = false">✕</button>
      </div>
      @if (errorModalFormulario) {
        <div class="modal-alert-error">{{ errorModalFormulario }}</div>
      }
      <form class="modal-form" (ngSubmit)="guardarTicket()" novalidate>
        <div class="form-field" [class.form-field-invalid]="erroresFormulario['titulo']"><label>Título</label><input
          name="tituloTicket" [(ngModel)]="formulario.titulo" maxlength="200"
          placeholder="Resume la incidencia" />@if (erroresFormulario['titulo']) {
          <small class="form-field-error">{{ erroresFormulario['titulo'] }}</small>
        }</div>
        <div class="form-field" [class.form-field-invalid]="erroresFormulario['descripcion']"><label>Descripción</label><textarea
          name="descripcionTicket" [(ngModel)]="formulario.descripcion" rows="5" maxlength="4000"
          placeholder="Describe el problema con el mayor detalle posible"></textarea>@if (erroresFormulario['descripcion']) {
          <small class="form-field-error">{{ erroresFormulario['descripcion'] }}</small>
        }</div>
        <div class="form-row-2">
          <div class="form-field" [class.form-field-invalid]="erroresFormulario['idCategoria']"><label>Categoría</label><select
            name="categoriaTicket" [(ngModel)]="formulario.idCategoria">
            <option [ngValue]="0">Seleccionar categoría</option>@for (c of categorias; track c.idCategoria) {
            <option [ngValue]="c.idCategoria">{{ c.nombre }}</option>
          }</select>@if (erroresFormulario['idCategoria']) {
            <small class="form-field-error">{{ erroresFormulario['idCategoria'] }}</small>
          }</div>
          <div class="form-field" [class.form-field-invalid]="erroresFormulario['idPrioridad']"><label>Prioridad</label><select
            name="prioridadTicket" [(ngModel)]="formulario.idPrioridad">
            <option [ngValue]="0">Seleccionar prioridad</option>@for (p of prioridades; track p.idPrioridad) {
            <option [ngValue]="p.idPrioridad">{{ formatearPrioridad(p.nombre) }}</option>
          }</select>@if (erroresFormulario['idPrioridad']) {
            <small class="form-field-error">{{ erroresFormulario['idPrioridad'] }}</small>
          }</div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-cancel" (click)="mostrarModalFormulario = false">Cancelar</button>
          <button type="submit" class="btn-save"
                  [disabled]="guardandoTicket">{{ guardandoTicket ? 'Guardando...' : (editando ? 'Guardar cambios' : 'Crear ticket') }}
          </button>
        </div>
      </form>
    </div>
  </div>
}

@if (mostrarModalAsignar && ticketDetalle) {
  <div class="modal-backdrop" (click)="mostrarModalAsignar = false">
    <div class="modal-card modal-card-sm" (click)="$event.stopPropagation()">
      <div class="modal-header">
        <div><p class="modal-kicker">{{ ticketDetalle.codigoTicket }}</p>
          <h2 class="modal-title">Asignar técnico</h2>
          <p class="modal-subtitle">Selecciona un integrante disponible del equipo de soporte.</p></div>
        <button type="button" class="btn-close" (click)="mostrarModalAsignar = false">✕</button>
      </div>
      @if (errorAsignar) {
        <div class="modal-alert-error">{{ errorAsignar }}</div>
      }
      <div class="modal-form">
        <div class="form-field"><label>Técnico disponible</label><select [(ngModel)]="tecnicoSeleccionado">
          <option [ngValue]="0">Seleccionar técnico</option>@for (t of tecnicos; track t.idTecnico) {
          <option [ngValue]="t.idTecnico"
                  [disabled]="t.disponibilidad !== 'DISPONIBLE'">{{ t.nombres }} {{ t.apellidos }}
            · {{ t.especialidad }} · {{ formatearEstado(t.disponibilidad) }}
          </option>
        }</select></div>
        <div class="form-field"><label>Nota de asignación</label><textarea [(ngModel)]="descripcionAsignacion" rows="4"
                                                                           maxlength="1000"
                                                                           placeholder="Añade una nota opcional sobre la asignación"></textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-cancel" (click)="mostrarModalAsignar = false">Cancelar</button>
          <button type="button" class="btn-save" (click)="asignarTecnico()">Asignar técnico</button>
        </div>
      </div>
    </div>
  </div>
}

@if (mostrarModalEstado && ticketDetalle) {
  <div class="modal-backdrop" (click)="mostrarModalEstado = false">
    <div class="modal-card modal-card-sm" (click)="$event.stopPropagation()">
      <div class="modal-header">
        <div><p class="modal-kicker">{{ ticketDetalle.codigoTicket }}</p>
          <h2 class="modal-title">{{ esAdmin && esCerrado(ticketDetalle) ? 'Reabrir ticket' : 'Cambiar estado' }}</h2>
          <p class="modal-subtitle">Actualiza el avance de la atención y deja constancia del cambio.</p></div>
        <button type="button" class="btn-close" (click)="mostrarModalEstado = false">✕</button>
      </div>
      @if (errorEstado) {
        <div class="modal-alert-error">{{ errorEstado }}</div>
      }
      <div class="modal-form">
        <div class="form-field"><label>Nuevo estado</label><select
          [(ngModel)]="estadoSeleccionado">@for (e of estadosDisponiblesCambio; track e.idEstado) {
          <option [ngValue]="e.idEstado">{{ formatearEstado(e.nombre) }}</option>
        }</select></div>
        <div class="form-field"><label>Descripción del cambio</label><textarea [(ngModel)]="descripcionEstado"
                                                                               maxlength="1000" rows="3"
                                                                               placeholder="Describe brevemente la actualización"></textarea>
        </div>
        @if (nombreEstadoSeleccionado === 'RESUELTO') {
          <div class="form-field"><label>Solución aplicada</label><textarea [(ngModel)]="solucionEstado"
                                                                            maxlength="4000" rows="4"
                                                                            placeholder="Describe la solución aplicada al incidente"></textarea>
          </div>
        }
        <div class="modal-footer">
          <button type="button" class="btn-cancel" (click)="mostrarModalEstado = false">Cancelar</button>
          <button type="button" class="btn-save" (click)="cambiarEstado()">Actualizar estado</button>
        </div>
      </div>
    </div>
  </div>
}

@if (mostrarModalDetalle && ticketDetalle) {
  <div class="modal-backdrop" (click)="mostrarModalDetalle = false">
    <div class="modal-card ticket-detail-modal" (click)="$event.stopPropagation()">
      <div class="modal-header ticket-detail-header">
        <div><p class="modal-kicker">{{ ticketDetalle.codigoTicket }}</p>
          <h2 class="modal-title">{{ ticketDetalle.titulo }}</h2>
          <p class="modal-subtitle">Detalle, conversación e historial de la solicitud.</p></div>
        <button type="button" class="btn-close" (click)="mostrarModalDetalle = false">✕</button>
      </div>

      <div class="ticket-detail-grid">
        <section class="ticket-detail-main">
          <div class="detail-section-card"><h3>Descripción</h3>
            <p>{{ ticketDetalle.descripcion }}</p></div>
          @if (ticketDetalle.solucion) {
            <div class="detail-section-card solution-card">
              <div class="detail-section-icon solution-icon">✓</div>
              <div><h3>Solución aplicada</h3>
                <p>{{ ticketDetalle.solucion }}</p></div>
            </div>
          }

          <div class="detail-section-heading">
            <div><h3>Conversación</h3>
              <p>Seguimiento entre el solicitante y el equipo de soporte.</p></div>
            <span>{{ comentarios.length }} comentario(s)</span></div>
          <div class="comments-list">
            @for (c of comentarios; track c.idComentario) {
              <div class="comment-item">
                <div class="comment-avatar">{{ inicialesComentario(c) }}</div>
                <div class="comment-content">
                  <div class="comment-meta"><strong>{{ nombreComentario(c) }}</strong>@if (rolComentario(c)) {
                    <span class="comment-role">{{ rolComentario(c) }}</span>
                  }<span>{{ c.fechaComentario | date:'d MMM yyyy, HH:mm' }}</span></div>
                  <p>{{ c.comentario }}</p></div>
              </div>
            } @empty {
              <div class="detail-empty">Aún no hay comentarios registrados.</div>
            }
          </div>

          @if (ticketCerrado) {
            <div class="closed-ticket-notice"><strong>Ticket cerrado</strong>
              <p>La conversación está bloqueada. Solo un administrador puede reabrir el ticket para permitir nuevas
                modificaciones.</p></div>
          } @else {
            <div class="comment-composer" [class.form-field-invalid]="errorComentario"><textarea
              [(ngModel)]="comentarioNuevo" maxlength="4000" rows="3"
              placeholder="Escribe un comentario..."></textarea>@if (errorComentario) {
              <small class="form-field-error">{{ errorComentario }}</small>
            }
              <button type="button" class="btn-save" (click)="agregarComentario()"
                      [disabled]="enviandoComentario">{{ enviandoComentario ? 'Enviando...' : 'Enviar comentario' }}
              </button>
            </div>
          }
        </section>

        <aside class="ticket-detail-side">
          <div class="detail-side-card">
            <h3>Información</h3>
            <div class="detail-info-row"><span>Estado</span><strong>{{ formatearEstado(ticketDetalle.estado) }}</strong>
            </div>
            <div class="detail-info-row">
              <span>Prioridad</span><strong>{{ formatearPrioridad(ticketDetalle.prioridad) }}</strong></div>
            <div class="detail-info-row"><span>Categoría</span><strong>{{ ticketDetalle.categoria }}</strong></div>
            <div class="detail-info-row">
              <span>Solicitante</span><strong>{{ ticketDetalle.usuarioCreador || 'Usuario' }}</strong></div>
            <div class="detail-info-row">
              <span>Técnico</span><strong>{{ ticketDetalle.tecnicoAsignado || 'Sin asignar' }}</strong></div>
            <div class="detail-info-row">
              <span>Creado</span><strong>{{ ticketDetalle.fechaCreacion | date:'d MMM yyyy, HH:mm' }}</strong></div>
            @if (ticketDetalle.fechaAsignacion) {
              <div class="detail-info-row">
                <span>Asignado</span><strong>{{ ticketDetalle.fechaAsignacion | date:'d MMM yyyy, HH:mm' }}</strong>
              </div>
            }
            @if (ticketDetalle.fechaResolucion) {
              <div class="detail-info-row">
                <span>Resuelto</span><strong>{{ ticketDetalle.fechaResolucion | date:'d MMM yyyy, HH:mm' }}</strong>
              </div>
            }
          </div>

          <div class="detail-side-card">
            <div class="detail-section-heading side-heading">
              <div><h3>Historial</h3>
                <p>Línea de tiempo del ticket.</p></div>
            </div>
            <div class="timeline">
              @for (h of historial; track h.idHistorial) {
                <div class="timeline-item"><span class="timeline-dot"></span>
                  <div class="timeline-copy"><strong>{{ h.accion.replaceAll('_', ' ') }}</strong>
                    <p
                      class="timeline-user">{{ h.idUsuario === idUsuarioActual ? 'Tú' : (h.nombreUsuario || 'Usuario') }}</p>@if (h.estadoAnterior || h.estadoNuevo || h.descripcion) {
                      <p>@if (h.estadoAnterior || h.estadoNuevo) {
                        {{ h.estadoAnterior || '—' }} → {{ h.estadoNuevo || '—' }}
                      }
                        @if (h.descripcion) {
                          <span> · {{ h.descripcion }}</span>
                        }</p>
                    }<small>{{ h.fecha | date:'d MMM yyyy, HH:mm' }}</small></div>
                </div>
              } @empty {
                <div class="detail-empty">Sin movimientos registrados.</div>
              }
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
}
</file>

<file path="src/app/pages/tickets/tickets.ts">
import { ChangeDetectorRef, Component, OnInit, inject } from '@angular/core';
import { CommonModule } from '@angular/common';
import { ActivatedRoute } from '@angular/router';
import { FormsModule } from '@angular/forms';
import { AuthService } from '../../services/auth.service';
import { TecnicoService } from '../../services/tecnico.service';
import { TicketService } from '../../services/ticket.service';
import { TecnicoItem } from '../../models/tecnico.model';
import {
  CategoriaItem,
  ComentarioTicketItem,
  EstadoTicketItem,
  HistorialTicketItem,
  PrioridadItem,
  TicketItem,
} from '../../models/ticket.model';

@Component({
  selector: 'app-tickets',
  standalone: true,
  imports: [CommonModule, FormsModule],
  templateUrl: './tickets.html',
  styleUrl: './tickets.css',
})
export class Tickets implements OnInit {
  private readonly ticketService = inject(TicketService);
  private readonly tecnicoService = inject(TecnicoService);
  private readonly authService = inject(AuthService);
  private readonly route = inject(ActivatedRoute);
  private readonly cdr = inject(ChangeDetectorRef);

  modo: 'todos' | 'mios' | 'asignados' = 'todos';
  tickets: TicketItem[] = [];
  categorias: CategoriaItem[] = [];
  prioridades: PrioridadItem[] = [];
  estados: EstadoTicketItem[] = [];
  tecnicos: TecnicoItem[] = [];

  cargando = false;
  mensaje = '';
  error = '';
  filtroTexto = '';
  filtroEstado = 'TODOS';
  filtroPrioridad = 'TODAS';
  filtroCategoria = 'TODAS';

  mostrarModalFormulario = false;
  editando = false;
  idTicketEditar: number | null = null;
  guardandoTicket = false;
  errorModalFormulario = '';
  erroresFormulario: Record<string, string> = {};
  formulario = { titulo: '', descripcion: '', idCategoria: 0, idPrioridad: 0 };

  mostrarModalDetalle = false;
  ticketDetalle: TicketItem | null = null;
  historial: HistorialTicketItem[] = [];
  comentarios: ComentarioTicketItem[] = [];
  comentarioNuevo = '';
  errorComentario = '';
  enviandoComentario = false;

  mostrarModalAsignar = false;
  tecnicoSeleccionado = 0;
  descripcionAsignacion = '';
  errorAsignar = '';

  mostrarModalEstado = false;
  estadoSeleccionado = 0;
  descripcionEstado = '';
  solucionEstado = '';
  errorEstado = '';

  ngOnInit(): void {
    this.route.data.subscribe((data) => {
      this.modo = (data['modo'] || 'todos') as typeof this.modo;
      this.cargarDatos();
    });
  }

  get idUsuarioActual(): number {
    return this.authService.getIdUsuario() || 0;
  }
  get rol(): string {
    return this.authService.getRol() || '';
  }
  get esAdmin(): boolean {
    return this.rol === 'ROLE_ADMIN';
  }
  get esTecnico(): boolean {
    return this.rol === 'ROLE_TECNICO';
  }
  get esUsuario(): boolean {
    return this.rol === 'ROLE_USUARIO';
  }

  get tituloPagina(): string {
    if (this.modo === 'mios') return 'Mis tickets';
    if (this.modo === 'asignados') return 'Mis tickets asignados';
    return 'Todos los tickets';
  }

  get subtituloPagina(): string {
    if (this.modo === 'mios') return 'Consulta el estado y seguimiento de tus solicitudes.';
    if (this.modo === 'asignados')
      return 'Gestiona únicamente los tickets asignados a tu perfil técnico.';
    return 'Supervisa, asigna y gestiona cada solicitud de soporte.';
  }

  get ticketsFiltrados(): TicketItem[] {
    const termino = this.filtroTexto.trim().toLowerCase();
    return this.tickets.filter((t) => {
      const coincideTexto =
        !termino ||
        (t.codigoTicket || '').toLowerCase().includes(termino) ||
        (t.titulo || '').toLowerCase().includes(termino) ||
        (t.usuarioCreador || '').toLowerCase().includes(termino) ||
        (t.tecnicoAsignado || '').toLowerCase().includes(termino);
      const coincideEstado = this.filtroEstado === 'TODOS' || t.estado === this.filtroEstado;
      const coincidePrioridad =
        this.filtroPrioridad === 'TODAS' || t.prioridad === this.filtroPrioridad;
      const coincideCategoria =
        this.filtroCategoria === 'TODAS' || t.categoria === this.filtroCategoria;
      return coincideTexto && coincideEstado && coincidePrioridad && coincideCategoria;
    });
  }

  get ticketCerrado(): boolean {
    return (this.ticketDetalle?.estado || '').toUpperCase() === 'CERRADO';
  }
  get nombreEstadoSeleccionado(): string {
    return this.estados.find((e) => e.idEstado === this.estadoSeleccionado)?.nombre || '';
  }
  get estadosDisponiblesCambio(): EstadoTicketItem[] {
    if (this.esAdmin) return this.estados;
    if (this.esTecnico) return this.estados.filter((e) => e.nombre !== 'CERRADO');
    return [];
  }

  cargarDatos(): void {
    this.cargando = true;
    this.error = '';
    this.ticketService.listarTickets().subscribe({
      next: (tickets) => {
        this.tickets = tickets || [];
        this.cargando = false;
        this.cdr.detectChanges();
      },
      error: (err) => {
        this.cargando = false;
        this.error = this.extraerError(err, 'No se pudieron cargar los tickets.');
        this.cdr.detectChanges();
      },
    });
    this.ticketService.listarCategorias().subscribe({
      next: (r) => {
        this.categorias = (r || []).filter((c) => c.estado !== false);
        this.cdr.detectChanges();
      },
    });
    this.ticketService.listarPrioridades().subscribe({
      next: (r) => {
        this.prioridades = r || [];
        this.cdr.detectChanges();
      },
    });
    this.ticketService.listarEstados().subscribe({
      next: (r) => {
        this.estados = r || [];
        this.cdr.detectChanges();
      },
    });
    if (this.esAdmin) {
      this.tecnicoService.listarTecnicosActivos().subscribe({
        next: (r) => {
          if (r.rpta === 1 && r.body) this.tecnicos = r.body;
          this.cdr.detectChanges();
        },
      });
    }
  }

  abrirNuevoTicket(): void {
    this.editando = false;
    this.idTicketEditar = null;
    this.errorModalFormulario = '';
    this.erroresFormulario = {};
    this.formulario = { titulo: '', descripcion: '', idCategoria: 0, idPrioridad: 0 };
    this.mostrarModalFormulario = true;
  }

  abrirEditar(t: TicketItem): void {
    if (this.esCerrado(t)) return;
    this.editando = true;
    this.idTicketEditar = t.idTicket;
    this.errorModalFormulario = '';
    this.erroresFormulario = {};
    this.formulario = {
      titulo: t.titulo,
      descripcion: t.descripcion,
      idCategoria: t.idCategoria,
      idPrioridad: t.idPrioridad,
    };
    this.mostrarModalFormulario = true;
  }

  guardarTicket(): void {
    this.errorModalFormulario = '';
    this.erroresFormulario = {};
    if (!this.validarFormularioTicket()) return;
    this.guardandoTicket = true;

    if (this.editando && this.idTicketEditar) {
      this.ticketService
        .actualizarTicket(this.idTicketEditar, {
          ...this.formulario,
          titulo: this.formulario.titulo.trim(),
          descripcion: this.formulario.descripcion.trim(),
        })
        .subscribe({
          next: () => {
            this.guardandoTicket = false;
            this.exitoYRecargar('Ticket actualizado correctamente.');
          },
          error: (e) => {
            this.guardandoTicket = false;
            this.errorModalFormulario = this.extraerError(e, 'No se pudo actualizar el ticket.');
            this.cdr.detectChanges();
          },
        });
      return;
    }

    this.ticketService
      .crearTicket({
        ...this.formulario,
        titulo: this.formulario.titulo.trim(),
        descripcion: this.formulario.descripcion.trim(),
      })
      .subscribe({
        next: () => {
          this.guardandoTicket = false;
          this.exitoYRecargar('Ticket creado correctamente.');
        },
        error: (e) => {
          this.guardandoTicket = false;
          this.errorModalFormulario = this.extraerError(e, 'No se pudo crear el ticket.');
          this.cdr.detectChanges();
        },
      });
  }

  verDetalle(t: TicketItem): void {
    this.mostrarModalDetalle = true;
    this.ticketDetalle = t;
    this.comentarioNuevo = '';
    this.errorComentario = '';
    this.cargarDetalle(t.idTicket);
  }

  cargarDetalle(id: number): void {
    this.ticketService.obtenerTicket(id).subscribe({
      next: (r) => {
        this.ticketDetalle = r;
        this.cdr.detectChanges();
      },
    });
    this.ticketService.listarHistorial(id).subscribe({
      next: (r) => {
        this.historial = r || [];
        this.cdr.detectChanges();
      },
    });
    this.ticketService.listarComentarios(id).subscribe({
      next: (r) => {
        this.comentarios = r || [];
        this.cdr.detectChanges();
      },
    });
  }

  agregarComentario(): void {
    if (!this.ticketDetalle || this.ticketCerrado) return;
    this.errorComentario = '';
    const comentario = this.comentarioNuevo.trim();
    if (!comentario) {
      this.errorComentario = 'Escribe un comentario antes de enviarlo.';
      return;
    }
    if (comentario.length > 4000) {
      this.errorComentario = 'El comentario no puede superar 4000 caracteres.';
      return;
    }
    this.enviandoComentario = true;
    this.ticketService.agregarComentario(this.ticketDetalle.idTicket, { comentario }).subscribe({
      next: () => {
        this.enviandoComentario = false;
        this.comentarioNuevo = '';
        this.cargarDetalle(this.ticketDetalle!.idTicket);
      },
      error: (e) => {
        this.enviandoComentario = false;
        this.errorComentario = this.extraerError(e, 'No se pudo agregar el comentario.');
        this.cdr.detectChanges();
      },
    });
  }

  abrirAsignar(t: TicketItem): void {
    if (this.esCerrado(t)) return;
    this.ticketDetalle = t;
    this.tecnicoSeleccionado = t.idTecnicoAsignado || 0;
    this.descripcionAsignacion = '';
    this.errorAsignar = '';
    this.mostrarModalAsignar = true;
  }

  asignarTecnico(): void {
    if (!this.ticketDetalle) return;
    this.errorAsignar = '';
    if (!this.tecnicoSeleccionado) {
      this.errorAsignar = 'Selecciona un técnico disponible.';
      return;
    }
    this.ticketService
      .asignarTecnico(this.ticketDetalle.idTicket, {
        idTecnico: this.tecnicoSeleccionado,
        descripcion: this.descripcionAsignacion.trim(),
      })
      .subscribe({
        next: () => this.exitoYRecargar('Técnico asignado correctamente.'),
        error: (e) => {
          this.errorAsignar = this.extraerError(e, 'No se pudo asignar el técnico.');
          this.cdr.detectChanges();
        },
      });
  }

  abrirCambiarEstado(t: TicketItem): void {
    if (!this.esAdmin && this.esCerrado(t)) return;
    this.ticketDetalle = t;
    this.estadoSeleccionado = t.idEstado;
    this.descripcionEstado = '';
    this.solucionEstado = t.solucion || '';
    this.errorEstado = '';
    this.mostrarModalEstado = true;
  }

  cambiarEstado(): void {
    if (!this.ticketDetalle || !this.estadoSeleccionado) return;
    this.errorEstado = '';
    if (this.estadoSeleccionado === this.ticketDetalle.idEstado) {
      this.errorEstado = 'Selecciona un estado diferente al actual.';
      return;
    }
    if (this.nombreEstadoSeleccionado === 'RESUELTO' && !this.solucionEstado.trim()) {
      this.errorEstado = 'Registra la solución aplicada para marcar el ticket como resuelto.';
      return;
    }
    this.ticketService
      .cambiarEstado(this.ticketDetalle.idTicket, {
        idEstado: this.estadoSeleccionado,
        descripcion: this.descripcionEstado.trim(),
        solucion: this.solucionEstado.trim(),
      })
      .subscribe({
        next: () => this.exitoYRecargar('Estado actualizado correctamente.'),
        error: (e) => {
          this.errorEstado = this.extraerError(e, 'No se pudo cambiar el estado.');
          this.cdr.detectChanges();
        },
      });
  }

  puedeEditar(t: TicketItem): boolean {
    if (this.esCerrado(t)) return false;
    return this.esAdmin || (this.esUsuario && t.estado === 'CREADO');
  }

  puedeAsignar(t: TicketItem): boolean {
    return this.esAdmin && !this.esCerrado(t);
  }
  puedeGestionarEstado(t: TicketItem): boolean {
    return this.esAdmin || (this.esTecnico && !this.esCerrado(t));
  }
  esCerrado(t: TicketItem): boolean {
    return (t.estado || '').toUpperCase() === 'CERRADO';
  }

  nombreComentario(c: ComentarioTicketItem): string {
    return c.idUsuario === this.idUsuarioActual ? 'Tú' : c.nombreUsuario || 'Usuario';
  }

  inicialesComentario(c: ComentarioTicketItem): string {
    if (c.idUsuario === this.idUsuarioActual) return 'TÚ';
    return this.obtenerIniciales(c.nombreUsuario || 'Usuario');
  }

  rolComentario(c: ComentarioTicketItem): string {
    if (c.idUsuario === this.idUsuarioActual) return '';
    if (c.rolUsuario === 'TECNICO') return 'Técnico';
    if (c.rolUsuario === 'ADMIN') return 'Administrador';
    return 'Usuario';
  }

  formatearPrioridad(v: string): string {
    const p = (v || '').toUpperCase();
    if (p === 'CRITICA' || p === 'CRÍTICA') return 'Crítica';
    return p.charAt(0) + p.slice(1).toLowerCase();
  }

  formatearEstado(v: string): string {
    return (v || '')
      .toLowerCase()
      .replaceAll('_', ' ')
      .replace(/^./, (c) => c.toUpperCase());
  }
  obtenerIniciales(nombre?: string | null): string {
    return nombre
      ? nombre
          .split(' ')
          .filter(Boolean)
          .slice(0, 2)
          .map((p) => p[0])
          .join('')
          .toUpperCase()
      : '--';
  }
  esCritica(v: string): boolean {
    return ['CRITICA', 'CRÍTICA'].includes((v || '').toUpperCase());
  }

  private validarFormularioTicket(): boolean {
    const titulo = this.formulario.titulo.trim();
    const descripcion = this.formulario.descripcion.trim();
    if (!titulo) this.erroresFormulario['titulo'] = 'El título es obligatorio.';
    else if (titulo.length > 200)
      this.erroresFormulario['titulo'] = 'El título no puede superar 200 caracteres.';
    if (!descripcion) this.erroresFormulario['descripcion'] = 'La descripción es obligatoria.';
    else if (descripcion.length > 4000)
      this.erroresFormulario['descripcion'] = 'La descripción no puede superar 4000 caracteres.';
    if (!this.formulario.idCategoria)
      this.erroresFormulario['idCategoria'] = 'Selecciona una categoría.';
    if (!this.formulario.idPrioridad)
      this.erroresFormulario['idPrioridad'] = 'Selecciona una prioridad.';
    return Object.keys(this.erroresFormulario).length === 0;
  }

  private exitoYRecargar(mensaje: string): void {
    this.mensaje = mensaje;
    this.error = '';
    this.mostrarModalFormulario = false;
    this.mostrarModalAsignar = false;
    this.mostrarModalEstado = false;
    this.cargarDatos();
    if (this.ticketDetalle) this.cargarDetalle(this.ticketDetalle.idTicket);
    setTimeout(() => {
      this.mensaje = '';
      this.cdr.detectChanges();
    }, 3000);
  }

  private extraerError(error: any, fallback: string): string {
    return error?.error?.detail || error?.error?.message || error?.error?.mensaje || fallback;
  }
}
</file>

