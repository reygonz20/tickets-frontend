  display: block;
  margin-top: 0.35rem;
  color: #64748b;
  font-size: 0.74rem;
}

button:disabled {
  opacity: 0.55;
  cursor: not-allowed !important;
}

.page-alert {
  margin-bottom: 1rem;
  padding: 0.8rem 1rem;
  border-radius: 12px;
  font-size: 0.84rem;
  font-weight: 600;
}

.page-alert-success {
  background: #ecfdf5;
  color: #047857;
  border: 1px solid #a7f3d0;
}

.page-alert-error {
  background: #fef2f2;
  color: #b91c1c;
  border: 1px solid #fecaca;
}
